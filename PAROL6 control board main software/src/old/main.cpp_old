    TMC5160Stepper(SELECT3, R_SENSE)
};

AccelStepper stepper[] = {
    AccelStepper(AccelStepper::DRIVER, PUL1, DIR1),
    AccelStepper(AccelStepper::DRIVER, PUL6, DIR6),
    AccelStepper(AccelStepper::DRIVER, PUL5, DIR5),
    AccelStepper(AccelStepper::DRIVER, PUL4, DIR4),
    AccelStepper(AccelStepper::DRIVER, PUL2, DIR2),
    AccelStepper(AccelStepper::DRIVER, PUL3, DIR3)
};

// Переменные для измерения времени между командами
volatile unsigned tick_count;
unsigned long current_tick = 0;
unsigned long prev_tick = 0;

// Переменные для гоминга робота
int robot_homed = 0;
int homed = 0;
int repet_flag = 0;
int home_command = 0;

// Вспомогательные переменные для приема данных по Serial
byte input_byte = 0;
byte start_cond1_byte = 255;
byte start_cond2_byte = 255;
byte start_cond3_byte = 255;
byte end_cond1_byte = 1;
byte end_cond2_byte = 2;
byte start_cond1 = 0;
byte start_cond2 = 0;
byte start_cond3 = 0;
byte good_start = 0;
byte data_len = 0;
byte data_buffer[255];
byte data_counter = 0;

// Данные для отправки
uint8_t start_bytes[] = {0xff, 0xff, 0xff};
uint8_t end_bytes[] = {0x01, 0x02};

// Для пневматического гриппера
int j5_homing_offset = 8900;  // для SSG48 GRIPPER 8035

// Состояния гоминга
int run_once = 0;
int joint123_stage1 = 0;
int joint123_stage2 = 0;
int joint123_stage3 = 0;
int joint123_done = 0;
int J4_stage2 = 0;
int J4_stage3 = 0;
int J4_stage4 = 0;
int J4_done = 0;
int J6_stage2 = 0;
int J6_stage3 = 0;
int J6_stage4 = 0;
int J6_done = 0;
int J5_stage2 = 0;
int J5_stage3 = 0;
int J5_stage4 = 0;
int J5_done = 0;
int joint456_stage1 = 0;
int joint456_stage2 = 0;
int joint456_stage3 = 0;

// Демо-режим
int setup_var = 0;
int move1 = 0;
int move2 = 0;
int move3 = 0;
int move4 = 0;
int start_stop = 0;

// Прототипы функций
