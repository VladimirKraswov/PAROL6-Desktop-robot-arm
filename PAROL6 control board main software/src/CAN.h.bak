#ifndef CAN_UTILS_H
#define CAN_UTILS_H

#include <Arduino.h>
#include <STM32H7xx_HAL_Driver.h>
#include <stm32h7xx_hal_can.h>

#define DEBUG_CAN 0

typedef enum {
    CAN_50KBPS, 
    CAN_100KBPS, 
    CAN_125KBPS, 
    CAN_250KBPS, 
    CAN_500KBPS, 
    CAN_1000KBPS
} BITRATE;

typedef enum {
    STANDARD_FORMAT = 0, 
    EXTENDED_FORMAT
} CAN_FORMAT;

typedef enum {
    DATA_FRAME = 0, 
    REMOTE_FRAME
} CAN_FRAME;

typedef struct {
    uint32_t id;
    uint8_t  data[8];
    uint8_t  len;
    uint8_t  format;
    uint8_t  type;
} CAN_msg_t;

// Для Arduino-фреймворка обычно используется CAN1
extern CAN_HandleTypeDef hcan1;

bool CANInit(BITRATE bitrate);
void CANReceive(CAN_msg_t* CAN_rx_msg);
void CANSend(CAN_msg_t* CAN_tx_msg);
uint8_t CANMsgAvail(void);

#endif