#include "CAN.h"

// Дескриптор CAN, должен быть объявлен где-то в коде HAL (часто в main.c)
extern CAN_HandleTypeDef hcan1;
// Фильтр (принимаем все сообщения)
CAN_FilterTypeDef can_filter;

bool CANInit(BITRATE bitrate) {
    // 1. Настройка пинов CAN (PB8/PB9 для CAN1 на многих платах)
    //    Убедитесь, что эти пины соответствуют вашей плате Mellow Fly!
    //    Инициализация пинов обычно делается в HAL.
    //    Для Arduino можно использовать: pinMode(PB8, ALTERNATE); pinMode(PB9, ALTERNATE);

    // 2. Настройка скорости (прескалера)
    uint32_t prescaler = 0;
    switch(bitrate) {
        case CAN_1000KBPS: prescaler = 5; break; // Пример для H7 с ядром 200 MHz
        case CAN_500KBPS:  prescaler = 10; break;
        case CAN_250KBPS:  prescaler = 20; break;
        case CAN_125KBPS:  prescaler = 40; break;
        case CAN_100KBPS:  prescaler = 50; break;
        case CAN_50KBPS:   prescaler = 100; break;
        default: prescaler = 40; // 125 kbps по умолчанию
    }

    // 3. Базовая инициализация CAN (упрощенно)
    hcan1.Instance = CAN1;
    hcan1.Init.Prescaler = prescaler;
    hcan1.Init.Mode = CAN_MODE_NORMAL;
    hcan1.Init.SyncJumpWidth = CAN_SJW_1TQ;
    hcan1.Init.TimeSeg1 = CAN_BS1_13TQ;
    hcan1.Init.TimeSeg2 = CAN_BS2_2TQ;
    hcan1.Init.TimeTriggeredMode = DISABLE;
    hcan1.Init.AutoBusOff = DISABLE;
    hcan1.Init.AutoWakeUp = DISABLE;
    hcan1.Init.AutoRetransmission = ENABLE;
    hcan1.Init.ReceiveFifoLocked = DISABLE;
    hcan1.Init.TransmitFifoPriority = DISABLE;
    
    if (HAL_CAN_Init(&hcan1) != HAL_OK) {
        #if (DEBUG_CAN > 0)
        Serial.println("CAN HAL Init Failed!");
        #endif
        return false;
    }

    // 4. Настройка фильтра (принимаем все)
    can_filter.FilterBank = 0;
    can_filter.FilterMode = CAN_FILTERMODE_IDMASK;
    can_filter.FilterScale = CAN_FILTERSCALE_32BIT;
    can_filter.FilterIdHigh = 0x0000;
    can_filter.FilterIdLow = 0x0000;
    can_filter.FilterMaskIdHigh = 0x0000;
    can_filter.FilterMaskIdLow = 0x0000;
    can_filter.FilterFIFOAssignment = CAN_RX_FIFO0;
    can_filter.FilterActivation = ENABLE;
    can_filter.SlaveStartFilterBank = 14;
    
    if (HAL_CAN_ConfigFilter(&hcan1, &can_filter) != HAL_OK) {
        #if (DEBUG_CAN > 0)
        Serial.println("CAN Filter Config Failed!");
        #endif
        return false;
    }

    // 5. Запуск CAN
    if (HAL_CAN_Start(&hcan1) != HAL_OK) {
        #if (DEBUG_CAN > 0)
        Serial.println("CAN Start Failed!");
        #endif
        return false;
    }

    #if (DEBUG_CAN > 0)
    Serial.println("CAN Initialized (HAL)");
    #endif
    return true;
}

void CANSend(CAN_msg_t* CAN_tx_msg) {
    CAN_TxHeaderTypeDef tx_header;
    uint32_t tx_mailbox;

    tx_header.StdId = CAN_tx_msg->id; // Для стандартного ID
    tx_header.ExtId = CAN_tx_msg->id; // Для расширенного ID
    tx_header.RTR = (CAN_tx_msg->type == REMOTE_FRAME) ? CAN_RTR_REMOTE : CAN_RTR_DATA;
    tx_header.IDE = (CAN_tx_msg->format == EXTENDED_FORMAT) ? CAN_ID_EXT : CAN_ID_STD;
    tx_header.DLC = CAN_tx_msg->len;
    tx_header.TransmitGlobalTime = DISABLE;

    if (HAL_CAN_AddTxMessage(&hcan1, &tx_header, CAN_tx_msg->data, &tx_mailbox) != HAL_OK) {
        #if (DEBUG_CAN > 0)
        Serial.println("CAN Send Failed");
        #endif
    } else {
        #if (DEBUG_CAN > 0)
        Serial.print("CAN Sent ID: 0x");
        Serial.println(CAN_tx_msg->id, HEX);
        #endif
    }
}

void CANReceive(CAN_msg_t* CAN_rx_msg) {
    CAN_RxHeaderTypeDef rx_header;
    
    if (HAL_CAN_GetRxFifoFillLevel(&hcan1, CAN_RX_FIFO0) > 0) {
        if (HAL_CAN_GetRxMessage(&hcan1, CAN_RX_FIFO0, &rx_header, CAN_rx_msg->data) == HAL_OK) {
            CAN_rx_msg->id = (rx_header.IDE == CAN_ID_STD) ? rx_header.StdId : rx_header.ExtId;
            CAN_rx_msg->len = rx_header.DLC;
            CAN_rx_msg->format = (rx_header.IDE == CAN_ID_STD) ? STANDARD_FORMAT : EXTENDED_FORMAT;
            CAN_rx_msg->type = (rx_header.RTR == CAN_RTR_REMOTE) ? REMOTE_FRAME : DATA_FRAME;
            
            #if (DEBUG_CAN > 0)
            Serial.print("CAN Received ID: 0x");
            Serial.println(CAN_rx_msg->id, HEX);
            #endif
        }
    }
}

uint8_t CANMsgAvail(void) {
    return (HAL_CAN_GetRxFifoFillLevel(&hcan1, CAN_RX_FIFO0) > 0) ? 1 : 0;
}